package views

import (
    sqlc "tpe/Base_Datos/bd/sqlc"
    "strconv"
)

templ Lista_libros(libros []sqlc.Libro, mostrar bool, sortColumn, sortOrder string) {

    <div id="lista-libros">
        <table id="tabla-libros">
            <thead>
                <tr>
                    @SortableHeader("id", "ID", sortColumn, sortOrder, mostrar)
                    @SortableHeader("titulo", "Título", sortColumn, sortOrder, mostrar)
                    @SortableHeader("autor", "Autor", sortColumn, sortOrder, mostrar)
                    <th>Descripción</th>
                    @SortableHeader("valoracion", "Valoración", sortColumn, sortOrder, mostrar)
                    @SortableHeader("anio", "Año", sortColumn, sortOrder, mostrar)
                    @SortableHeader("genero_principal", "Género principal", sortColumn, sortOrder, mostrar)
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="cuerpo_tabla">
                for _, libro := range libros {
                    <tr>
                        <td>{ libro.ID }</td>
                        <td>{ libro.Titulo }</td>
                        <td>{ libro.Autor }</td>
                        <td>{ libro.Descripcion }</td>
                        <td>{ safeInt(libro.Valoracion) }</td>
                        <td>{ safeInt(libro.Anio) }</td>
                        <td>{ safeString(libro.GeneroPrincipal) }</td>
                        <td>
                            <button class="boton-eliminar"
                                hx-delete={ "/delete/" + strconv.Itoa(int(libro.ID)) }
                                hx-vals={ "{ \"sort\": \"" + sortColumn + "\", \"order\": \"" + sortOrder + "\" }" }
                                hx-target="#lista-libros"
                                hx-swap="outerHTML"
                                hx-confirm="¿Seguro que querés borrar este libro?"
                            >Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}